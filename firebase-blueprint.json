{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user preferences and notification settings.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "notificationsEnabled": { "type": "boolean", "description": "Whether the user wants to receive alerts." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Wager": {
      "title": "User Wager",
      "description": "Stores a user's specific Grand Salami bet.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the owner" },
        "line": { "type": "number", "description": "The run total line (e.g. 120.5)" },
        "side": { "type": "string", "enum": ["OVER", "UNDER"] },
        "date": { "type": "string", "format": "date", "description": "The date of the slate (YYYY-MM-DD)" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "line", "side", "date"]
    },
    "PushSubscriptionDetails": {
      "title": "Push Subscription Details",
      "description": "Details for push notification subscription.",
      "type": "object",
      "properties": {
        "endpoint": { "type": "string" },
        "keys": { "type": "object" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "subscribedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "unsubscribedAt": { "type": "string", "format": "date-time" },
        "platform": { "type": "string" }
      },
      "required": ["status"]
    },
    "GameLine": {
      "title": "MLB Game Over/Under Line",
      "description": "Official betting total for a single game.",
      "type": "object",
      "properties": {
        "gamePk": { "type": "number", "description": "The MLB Game ID" },
        "total": { "type": "number", "description": "The O/U line (e.g. 8.5)" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["gamePk", "total"]
    },
    "DeliCounterSettings": {
      "title": "Daily Salami Line",
      "description": "The main Grand Salami line for the community to vote on.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "line": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["date", "line"]
    },
    "DeliVote": {
      "title": "Community Vote",
      "description": "A user's public vote on the daily line.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "side": { "type": "string", "enum": ["OVER", "UNDER"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "side"]
    },
    "Feedback": {
      "title": "User Feedback",
      "description": "General feedback or bug reports from users.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "page": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "message", "createdAt"]
    },
    "DailyIntelligenceReport": {
      "title": "Daily Park Intelligence Report",
      "description": "Daily summary text provided by Ballpark Pal.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "lastUpdated": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content"]
    },
    "LeaderboardRecord": {
      "title": "User Leaderboard Record",
      "description": "Stores public streak statistics for a user's Grand Salami wagers.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the user" },
        "displayName": { "type": "string", "description": "The public name of the user" },
        "mlbStreak": { "type": "number", "description": "Active MLB winning streak" },
        "mlbMaxStreak": { "type": "number", "description": "All-time maximum MLB winning streak" },
        "nhlStreak": { "type": "number", "description": "Active NHL winning streak" },
        "nhlMaxStreak": { "type": "number", "description": "All-time maximum NHL winning streak" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "displayName", "mlbStreak", "mlbMaxStreak", "nhlStreak", "nhlMaxStreak"]
    }
  },
  "firestore": {
    "/dailyIntelligence/{date}": {
      "schema": "DailyIntelligenceReport",
      "description": "Daily park factor reports and summaries"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile and settings"
    },
    "/users/{userId}/wagers/{wagerId}": {
      "schema": "Wager",
      "description": "User's saved wagers"
    },
    "/users/{userId}/push_subscriptions/{endpointHash}": {
      "schema": "PushSubscriptionDetails",
      "description": "User's push notifications token/registrations"
    },
    "/leaderboard/{userId}": {
      "schema": "LeaderboardRecord",
      "description": "Public streak leaderboard records"
    },
    "/gameLines/{gamePk}": {
      "schema": "GameLine",
      "description": "Shared over/under lines for individual games"
    },
    "/deliSettings/{date}": {
      "schema": "DeliCounterSettings",
      "description": "Daily lines for public voting"
    },
    "/deliVotes/{voteId}": {
      "schema": "DeliVote",
      "description": "Public community votes"
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "User feedback messages"
    }
  }
}
